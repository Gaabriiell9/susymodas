generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Comptes (NextAuth) ───────────────────────────────────────────────────────
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role           @default(CUSTOMER)
  phone         String?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orders        Order[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Catalogue ────────────────────────────────────────────────────────────────
model Product {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  name          String
  description   String?
  price         Float
  originalPrice Float?
  category      String
  tags          String[]
  images        String[]
  sizes         String[]
  colors        String[]
  stock         Int            @default(0)
  sizeStock     Json           @default("{}")
  featured      Boolean        @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  @@index([category])
  @@index([active, createdAt])
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  productId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId Int
  quantity  Int     @default(1)
  size      String  @default("")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
}

// ─── Ventes ───────────────────────────────────────────────────────────────────
model Order {
  id               Int            @id @default(autoincrement())
  reference        String         @unique
  status           OrderStatus    @default(PENDING)
  deliveryMethod   DeliveryMethod @default(PICKUP)
  subtotal         Float
  shippingCost     Float          @default(0)
  totalAmount      Float
  userId           String?
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String?
  postalCode       String?
  city             String?
  notes            String?
  paymentMethod    PaymentMethod  @default(STRIPE)
  stripeSessionId  String?        @unique
  stockDecremented Boolean        @default(false)
  paidAt           DateTime?
  items            OrderItem[]
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int?
  productName  String
  productImage String?
  quantity     Int
  price        Float
  size         String?
  color        String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

enum OrderStatus {
  PENDING // en attente de paiement
  CONFIRMED // payée, à préparer
  READY // prête au retrait en boutique
  SHIPPED // expédiée
  DELIVERED // livrée / retirée
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  STRIPE
}

// ─── Réglages boutique (une seule ligne, id = 1) ─────────────────────────────
model StoreSettings {
  id                    Int      @id @default(1)
  shippingCost          Float    @default(8)
  freeShippingThreshold Float?   @default(150)
  storeAddress          String   @default("Kourou, Guyane française")
  storeHours            String   @default("Du mardi au samedi, 9h-12h30 et 15h-19h")
  whatsapp              String   @default("594694029596")
  announcement          String   @default("Retrait gratuit en boutique à Kourou, paiement 100 % sécurisé")
  updatedAt             DateTime @updatedAt
}
